{
  "name": "lanterm-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node web/build.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write \"web/**/*.{js,css,html}\" tests/browser/*.js playwright.config.js",
    "format:check": "prettier --check \"web/**/*.{js,css,html}\" tests/browser/*.js playwright.config.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "katex": "0.18.9",
    "marked": "18.0.14",
    "marked-katex-extension": "5.1.13",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0",
    "prettier": "3.9.6"
  }
}
