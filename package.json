{
  "name": "lanterm-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node web/build.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write \"web/**/*.{js,css,html}\" tests/browser/*.js playwright.config.js",
    "format:check": "prettier --check \"web/**/*.{js,css,html}\" tests/browser/*.js playwright.config.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.0",
    "prettier": "3.9.6"
  }
}
